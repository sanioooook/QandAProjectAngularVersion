# Copy to .env and adjust; every value is optional.

# Web app port and the address users open it at (used for links in emails).
# WEB_PORT=8090
# PUBLIC_URL=http://localhost:8090

# Database credentials (the database is only reachable inside the compose network).
# POSTGRES_PASSWORD=change-me

# Email. Without EMAIL_SMTP_HOST the app works without email: no confirmation, no password reset.
# To try it locally, catch every email in Mailpit (web UI on http://localhost:8026):
# COMPOSE_PROFILES=mail
# EMAIL_SMTP_HOST=mailpit
# EMAIL_SMTP_PORT=1025
# EMAIL_SMTP_SECURITY=None
#
# A real SMTP server instead:
# EMAIL_SMTP_HOST=smtp.example.com
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_USERNAME=user
# EMAIL_SMTP_PASSWORD=secret
# EMAIL_SMTP_SECURITY=StartTls
# EMAIL_FROM=QandA <noreply@example.com>
# EMAIL_REQUIRE_CONFIRMATION=true
